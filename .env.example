# API key for the Anthropic-compatible endpoint. Server-side only — never
# exposed to the client. An AgentRouter key goes here too; the SDK sends it as
# the Anthropic auth header, which is what AgentRouter expects.
# Leave unset to run in demo mode (canned replay, no live inference).
ANTHROPIC_API_KEY=

# Host for the Anthropic-compatible API. Defaults to AgentRouter
# (https://co.agentrouter.org) in lib/ai/models.ts.
# Must be the BARE HOST with no /v1 — the SDK appends /v1/messages itself, so a
# value ending in /v1 requests /v1/v1/messages and fails.
# Set to https://api.anthropic.com when using a native Anthropic key.
# ANTHROPIC_BASE_URL=https://co.agentrouter.org

# Model overrides. Defaults live in lib/ai/models.ts.
# Use whatever IDs the configured host serves — AgentRouter takes Anthropic-style
# IDs, but which models it exposes is an account-level detail.
# MODEL_ANSWER=claude-opus-5
# MODEL_CHALLENGE=claude-haiku-4-5
# MODEL_GRADER=claude-haiku-4-5
